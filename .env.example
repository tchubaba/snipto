APP_NAME=Snipto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8080
APP_URL="http://localhost:${APP_PORT}"
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Worker count for `php artisan serve` (the dev container's HTTP server).
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=snipto
DB_USERNAME=snipto
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure + Strict by default: browsers accept Secure cookies on http://localhost,
# and CI flips this to false for its non-localhost test host (see test.yml).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

CSP_ENABLED=true
CSP_ENABLED_WHILE_HOT_RELOADING=false
CSP_NONCE_ENABLED=true
CSP_REPORT_URI=/api/csp-report
# Report-to group name emitted in the CSP header; the CspReportingEndpoints
# middleware maps it to CSP_REPORT_URI via the Reporting-Endpoints header.
# Set to empty (CSP_REPORT_TO=) to disable report-to entirely.
CSP_REPORT_TO=snipto
CSP_NAVIGATE_TO_ENABLED=true

# =============================================================================
# Tiered rate limiting (tchubaba/tiered-throttle)
# =============================================================================
# Both settings below are honoured only in the environments listed under
# 'bypass_environments' in config/tiered-throttle.php (local, testing). Setting
# them on a host running APP_ENV=production is ignored — the limiter stays on and
# the refusal is logged — so a stray .env cannot take rate limiting offline.

# TIERED_THROTTLE_ENABLED: master switch for the tiered.throttle middleware.
#   Leave on for ordinary development; switch off for load tests or seeding.
TIERED_THROTTLE_ENABLED=true

# TIERED_THROTTLE_BYPASS_PRIVATE_RANGES: exempt loopback, RFC1918, link-local and
#   Docker bridge addresses so hammering the API locally never trips a tier. Set
#   to false when you want to watch the limiter escalate against your own IP.
TIERED_THROTTLE_BYPASS_PRIVATE_RANGES=true

# =============================================================================
# Client IP behind a reverse proxy
# =============================================================================
# TRUSTED_PROXIES: the address of a proxy whose X-Forwarded-For header Laravel
#   may believe, so $request->ip() reports the real client rather than the proxy.
#   Leave this UNSET unless a proxy genuinely sits in front of the app:
#     - Exposed directly (Docker Hub image on :8080, no proxy): REMOTE_ADDR is
#       already the client address. Setting this would let any matching peer
#       pick its own rate-limit key, so no ban would ever stick.
#     - docker-compose.prod.yml: leave unset. Nginx resolves the real client
#       address with the real_ip module before PHP-FPM sees the request.
#     - Your own Caddy/Traefik/nginx in front of :8080: set the proxy's address
#       as the app container sees it — an IP, a CIDR, or a comma-separated list.
#       Never '*', which trusts the client itself.
# TRUSTED_PROXIES=172.18.0.2

# =============================================================================
# Production (docker-compose.prod.yml) — CrowdSec & Nginx
# =============================================================================
# CROWDSEC_API_KEY: Generated by `make crowdsec-setup` after first deploy.
#   Run once to register the agent and generate an API key for the nginx bouncer.
CROWDSEC_API_KEY=

# CROWDSEC_LAPI_URL: URL of the CrowdSec Local API (LAPI) endpoint.
#   Must match the crowdsec service name in docker-compose.prod.yml.
CROWDSEC_LAPI_URL=http://crowdsec:8080

# NOTE: After running `make crowdsec-setup`, copy both CROWDSEC_API_KEY and
# CROWDSEC_LAPI_URL from .env.example into your local .env file, then restart nginx:
#   docker compose -f docker-compose.prod.yml up -d nginx

# SSL_CERT_DIR: Path to directory containing cert.pem + key.pem for Nginx HTTPS.
#   Required for production mode. Example: /path/to/your/certs
# SSL_CERT_DIR=/etc/nginx/ssl
