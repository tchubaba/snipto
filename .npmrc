# Supply-chain cooldown: skip any package version published less than 3 days
# ago when npm resolves dependencies (npm CLI 11.10.0+; older npm parses the
# key but ignores it). npm implements this as an internal `before` cutoff, so
# it must not be combined with `--before`. This gates resolution-time installs
# (npm install / npm update); an existing package-lock.json is honoured as-is
# by npm ci. Pinned by tests/Feature/DependencyCooldownTest.php, alongside the
# matching dependabot.yml and composer.json cooldowns.
min-release-age=3
